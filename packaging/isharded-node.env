# Keep this file readable by the isharded user only.
HOME=/var/lib/isharded
ISHARDED_NODE_ARGS=--node-id node-b --join https://10.0.0.5:8000 --control-port 8000 --bind-host 0.0.0.0 --cache-dir /var/lib/isharded/cache --log-file /var/log/isharded/node.log --tls-cert /etc/isharded/node-b.pem --tls-key /etc/isharded/node-b.key --ca-file /etc/isharded/ca.pem --keys-file /var/lib/isharded/access.json
