# Keep this file readable by the shardmesh user only.
HOME=/var/lib/shardmesh
SHARDMESH_NODE_ARGS=--node-id node-b --join https://10.0.0.5:8000 --control-port 8000 --bind-host 0.0.0.0 --cache-dir /var/lib/shardmesh/cache --log-file /var/log/shardmesh/node.log --tls-cert /etc/shardmesh/node-b.pem --tls-key /etc/shardmesh/node-b.key --ca-file /etc/shardmesh/ca.pem --keys-file /var/lib/shardmesh/access.json
